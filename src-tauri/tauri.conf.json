{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenFocus",
  "version": "0.1.0",
  "identifier": "com.madrimov.zenfocus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:vite",
    "beforeBuildCommand": "bun run build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "ZenFocus",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: https: data: https://img.youtube.com; media-src 'self' asset: https: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' asset: https://api.todoist.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg"],
    "externalBin": ["bin/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
